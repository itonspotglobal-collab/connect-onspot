modules = ["web", "python-3.11", "nodejs-22", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["jq", "glib", "gtk3", "pango", "cairo", "gdk-pixbuf", "alsa-lib", "dbus", "at-spi2-atk", "atk", "cups", "nss", "nspr", "expat", "fontconfig", "freetype", "harfbuzz", "libpng", "zlib", "libdrm", "mesa", "libxkbcommon", "xorg.libX11", "xorg.libxcb", "xorg.libXcomposite", "xorg.libXcursor", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXi", "xorg.libXrandr", "xorg.libXrender", "xorg.libXScrnSaver"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "admin-auth-check"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsc --noEmit"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "admin-auth-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsx scripts/verify-admin-auth.ts"

[workflows.workflow.metadata]
isValidation = true

[agent]
integrations = ["javascript_object_storage:1.0.0", "javascript_database:1.0.0", "javascript_openai:1.0.0", "javascript_stripe:1.0.0", "javascript_websocket:1.0.0", "javascript_log_in_with_replit:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]
APPLICATION_EMAIL_FROM = "careers@onspotglobal.com"
APPLICATION_EMAIL_FROM_NAME = "OnSpot Talent"
APPLICATION_EMAIL_REPLY_TO = "careers@onspotglobal.com"
PUBLIC_APP_URL = "https://talent.onspotglobal.com"
VITE_HOW_IT_WORKS_ENABLED = "true"
